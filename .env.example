# Public site labels. Keep the NSTR contract blank until the token is launched.
NEXT_PUBLIC_NSTR_CA=
NEXT_PUBLIC_NSTR_X_URL=
NEXT_PUBLIC_NSTR_BUY_URL=https://pump.fun/
NEXT_PUBLIC_SITE_URL=https://bullstr.vercel.app

# Railway worker. The mint values below must be set to the actual launched NSTR
# mint and verified quote/reward mint before starting the worker.
PROJECT_NAME="Near Strategy"
SOURCE_SYMBOL=NSTR
REWARD_TOKEN_SYMBOL=NEAR
REWARD_MODE=token
HELIUS_RPC_URL=
SOURCE_TOKEN_MINT=
REWARD_TOKEN_MINTS=
REWARD_TOKEN_SYMBOLS=NEAR
CREATOR_FEE_ASSET_MINT=
TREASURY_WALLET_SECRET=
TREASURY_PUBLIC_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE=

# Live transaction gates. Leave off until the token, fee asset, database,
# treasury and payout flow have all been verified on the intended network.
CLAIM_ENABLED=false
NSTR_ACTIVATED=false
BUY_ENABLED=false
AIRDROP_ENABLED=false
EPOCH_MINUTES=5
ELIGIBILITY_MIN=
MAX_WALLETS_PER_EPOCH=100
MAX_HOLDER_PCT=5
EXCLUDE_WALLETS=

# Consecutive-epoch bonus: starts at 1x, adds 1% per eligible epoch, caps at 2x.
HOLD_MULTIPLIER_STEP_BPS=100
HOLD_MULTIPLIER_MAX_BPS=20000

# Fee asset must be the single reward mint above. When set, the worker
# distributes the collected fee asset directly instead of swapping SOL.
# For a NEAR pair, verify the actual fee settlement mint before setting this.

# Payout safety and optional split controls.
SWAP_BALANCE_BPS=10000
SWAP_SLIPPAGE_BPS=300
SIDE_WALLET_BPS=0
SIDE_WALLET_PUBLIC_KEY=
MIN_SOL_RESERVE=0.3
AIRDROP_SOL_RESERVE=0.05
AIRDROP_BATCH_SIZE=4
AIRDROP_REWARD_BPS=10000
PRIORITY_FEE_SOL=0.000001
MIN_REWARD_RAW_TO_AIRDROP=1
MIN_SOL_REWARD_LAMPORTS_TO_AIRDROP=5000

# Other inherited worker modules remain disabled for this project.
CAT_AGENT_ENABLED=false
CAT_AGENT_EXECUTE=false
CAT_AGENT_ALLOW_SELLS=false
X_AGENT_ENABLED=false
X_AGENT_POST_ENABLED=false
